  m_InputSlots:
  - {fileID: 8926484042661620059}
  - {fileID: 8926484042661620060}
  - {fileID: 8926484042661620061}
  - {fileID: 8926484042661620062}
  - {fileID: 8926484042661620063}
  - {fileID: 8926484042661620064}
  - {fileID: 8926484042661620065}
  - {fileID: 8926484042661620069}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661620074}
  m_BlockName: Salpicadura Init
  m_HLSLCode: "void SalpicaduraInit(inout VFXAttributes attributes, in float Velocidad,
    in float LongitudCaida, in float Gravedad, in float Tamano, in float TamanoChorro,
    in float Intensidad, in float3 Direccion, in float4 ColorAgua)\n{\n  float g
    = max(Gravedad, 0.1);\n  float h = max(LongitudCaida, 0.05);\n  float v = max(Velocidad,
    0.0);\n  float d = h + 0.04;\n  float caida = (sqrt(v * v + 2.0 * g * d) - v)
    / g;\n  float ang = VFXRAND * 6.28318;\n  float3 dir = float3(cos(ang), 0.0,
    sin(ang));\n  float3 impacto = float3(Direccion.x * caida, -h + 0.01, Direccion.z
    * caida);\n  float3 origen = impacto + dir * TamanoChorro * 0.5 * VFXRAND;\n 
    float k = max(Intensidad, 0.0);\n  attributes.targetPosition = origen;\n  attributes.position
    = origen;\n  attributes.velocity = dir * lerp(0.15, 0.6, VFXRAND) * k + float3(0.0,
    lerp(0.5, 1.3, VFXRAND) * sqrt(k), 0.0);\n  attributes.lifetime = lerp(0.12,
    0.28, VFXRAND);\n  attributes.size = Tamano * lerp(0.8, 1.6, VFXRAND) * saturate(k
    * 4.0) * lerp(0.7, 1.0, saturate(k));\n  attributes.color = ColorAgua.rgb * lerp(1.1,
    1.45, VFXRAND);\n  attributes.alpha = ColorAgua.a;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SalpicaduraInit
    selectedIndex: 0

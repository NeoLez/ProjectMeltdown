  m_Name: 
  m_EditorClassIdentifier: 
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 8926484042661617592}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 8926484042661620042}
  - {fileID: 8926484042661620043}
  - {fileID: 8926484042661620044}
  - {fileID: 8926484042661620045}
  - {fileID: 8926484042661620046}
  - {fileID: 8926484042661620047}
  - {fileID: 8926484042661620048}
  - {fileID: 8926484042661620052}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661620057}
  m_BlockName: Gotas Init
  m_HLSLCode: "void GotasInit(inout VFXAttributes attributes, in float Velocidad,
    in float LongitudCaida, in float Gravedad, in float Tamano, in float TamanoChorro,
    in float Dispersion, in float3 Direccion, in float4 ColorAgua)\n{\n  float g
    = max(Gravedad, 0.1);\n  float h = max(LongitudCaida, 0.05);\n  float v = max(Velocidad,
    0.0) * lerp(0.5, 0.9, VFXRAND);\n  float ang = VFXRAND * 6.28318;\n  float radio
    = TamanoChorro * 0.5;\n  float3 dir = float3(cos(ang), 0.0, sin(ang));\n  float3
    origen = dir * radio;\n  float lateral = lerp(0.06, 0.22, VFXRAND) + Dispersion;\n 
    attributes.targetPosition = origen;\n  attributes.position = origen;\n  attributes.velocity
    = float3(Direccion.x, -v, Direccion.z) + dir * lateral;\n  attributes.lifetime
    = (sqrt(v * v + 2.0 * g * h) - v) / g;\n  attributes.size = Tamano * lerp(0.6,
    1.4, VFXRAND);\n  attributes.color = ColorAgua.rgb * lerp(0.9, 1.25, VFXRAND);\n 
    attributes.alpha = ColorAgua.a;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: GotasInit
    selectedIndex: 0

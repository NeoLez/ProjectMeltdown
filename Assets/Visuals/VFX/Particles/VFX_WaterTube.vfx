  m_InputSlots:
  - {fileID: 8926484042661620026}
  - {fileID: 8926484042661620027}
  - {fileID: 8926484042661620028}
  - {fileID: 8926484042661620029}
  - {fileID: 8926484042661620030}
  - {fileID: 8926484042661620031}
  - {fileID: 8926484042661620035}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661620040}
  m_BlockName: Chorro Init
  m_HLSLCode: "void ChorroInit(inout VFXAttributes attributes, in float Velocidad,
    in float LongitudCaida, in float Gravedad, in float Tamano, in float Dispersion,
    in float3 Direccion, in float4 ColorAgua)\n{\n  float g = max(Gravedad, 0.1);\n 
    float h = max(LongitudCaida, 0.05);\n  float v = max(Velocidad, 0.0);\n  float3
    origen = float3(0.0, 0.04, 0.0);\n  float d = origen.y + h;\n  float jx = VFXRAND
    * 2.0 - 1.0;\n  float jz = VFXRAND * 2.0 - 1.0;\n  attributes.targetPosition
    = origen;\n  attributes.position = origen;\n  attributes.velocity = float3(Direccion.x
    + jx * Dispersion, -v, Direccion.z + jz * Dispersion);\n  attributes.lifetime
    = (sqrt(v * v + 2.0 * g * d) - v) / g + 0.05;\n  attributes.size = Tamano * lerp(0.7,
    1.3, VFXRAND);\n  float tono = lerp(0.85, 1.15, VFXRAND);\n  attributes.color
    = ColorAgua.rgb * tono;\n  attributes.alpha = ColorAgua.a;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: ChorroInit
    selectedIndex: 0

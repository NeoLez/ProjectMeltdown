  m_EditorClassIdentifier: 
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 8926484042661617061}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 8926484042661620076}
  - {fileID: 8926484042661620077}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661620078}
  m_BlockName: Caida con gravedad
  m_HLSLCode: "void CaidaAgua(inout VFXAttributes attributes, in float Gravedad,
    in float LongitudCaida)\n{\n  float t = attributes.age;\n  float3 p = attributes.targetPosition
    + attributes.velocity * t;\n  p.y -= 0.5 * max(Gravedad, 0.1) * t * t;\n  p.y
    = max(p.y, -max(LongitudCaida, 0.05));\n  attributes.position = p;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: CaidaAgua
    selectedIndex: 0
